{
  "name": "music-visualizer",
  "version": "1.0.0",
  "description": "Chromium-based music visualizer with Spotify metadata and Apple TV casting",
  "main": "main.js",
  "author": "Eric Bercaw",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.ericbercaw.musicvisualizer",
    "productName": "Music Visualizer",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "artifactName": "Music Visualizer-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^27.0.0"
  }
}